# ---------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# NEVER commit `.env.local` (it is ignored by .gitignore).
# ---------------------------------------------------------------

# --- Browser-safe values (bundled into the front end) ---
# Supabase: Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon (public) key is protected by Row Level Security.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional. Biggest upload in MB. The real limit is your Supabase plan (Free = 50). On Pro, raise the limit in
# Supabase > Storage > Settings first, then set this (for example 2000).
VITE_MAX_UPLOAD_MB=50

# --- Server-only secrets (set these in Vercel > Settings > Environment Variables) ---
# Do NOT prefix with VITE_. They must never reach the browser.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# LiveKit Cloud: Project Settings > Keys
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Optional: enables the AI battle recap. Without it, that button reports "not configured".
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional: email notifications for new messages (https://resend.com). Without them the feature does nothing.
# EMAIL_FROM must use a domain verified in Resend, for example: Kezzo <no-reply@kezzo.live>
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM=Kezzo <no-reply@your-domain.example>
# Optional: your public site address, used for the link in the email (defaults to the address the app is served from).
SITE_URL=https://your-domain.example

# --- Cloudflare R2 (optional): keeps public photos/videos out of Supabase bandwidth ---
# Server side only (Vercel > Settings > Environment Variables). Never put real values in this file or on GitHub.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=kezzo-media
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# Browser side: the same public address as R2_PUBLIC_URL
VITE_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# --- Cloudflare Workers AI (optional): translates posts, comments and speech into the person's language ---
# Server side only (Vercel > Settings > Environment Variables). Never put real values in this file or on GitHub.
# CF_ACCOUNT_ID is optional when R2_ACCOUNT_ID is set (it is the same Cloudflare account id).
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_AI_TOKEN=your-workers-ai-api-token
