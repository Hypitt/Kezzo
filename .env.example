# ---------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# NEVER commit `.env.local` (it is ignored by .gitignore).
# ---------------------------------------------------------------

# --- Browser-safe values (bundled into the front end) ---
# Supabase: Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon (public) key is protected by Row Level Security.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional. Biggest upload in MB. Leave it out for 4 GB (4096), like Instagram videos.
# The real limit is your Supabase plan: Free = 50 MB per file and cannot be raised, so on Free set this to 50.
# On Pro, set Supabase > Storage > Settings > "Global file size limit" to 4 GB.
# VITE_MAX_UPLOAD_MB=50

# --- Server-only secrets (set these in Vercel > Settings > Environment Variables) ---
# Do NOT prefix with VITE_. They must never reach the browser.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# LiveKit Cloud: Project Settings > Keys
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Optional: enables the AI battle recap. Without it, that button reports "not configured".
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
