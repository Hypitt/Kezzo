  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Live Battles", "short_name": "Battles", "url": "/#/battles", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Create", "short_name": "Create", "url": "/#/create", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Messages", "short_name": "Messages", "url": "/#/messages", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
